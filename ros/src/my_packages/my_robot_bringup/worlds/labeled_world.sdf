<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="default">
    <gravity>0 0 -9.8000000000000007</gravity>
    <magnetic_field>6.0000000000000002e-06 2.3e-05 -4.1999999999999998e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.400000006 0.400000006 0.400000006 1</ambient>
      <background>0.699999988 0.699999988 0.699999988 1</background>
      <shadows>true</shadows>
    </scene>

    <audio>
      <device>default</device>
    </audio>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <gui fullscreen="false">
      <camera name="user_camera">
        <pose>-1.58866 -7.3818400000000004 7.1969500000000002 0 0.66180000000000061 1.0642600000000004</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.10000000000000001 -0.90000000000000002</direction>
      <diffuse>0.800000012 0.800000012 0.800000012 1</diffuse>
      <specular>0.200000003 0.200000003 0.200000003 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.90000000000000002</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <light name="pointlight" type="point">
      <pose>0.35389590697512352 0.16178236750752895 2 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>4</range>
        <linear>0.5</linear>
        <constant>0.20000000000000001</constant>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- 25x25 white floor -->
    <include>
      <uri>model://labeled_floor</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

        <!-- labeled boxes -->
    <include>
      <uri>model://labeled_box_a</uri>
      <name>labeled_box_a</name>
      <pose>-2 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://labeled_box_b</uri>
      <name>labeled_box_b</name>
      <pose>0 2 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://labeled_box_c</uri>
      <name>labeled_box_c</name>
      <pose>2 0 0 0 0 0</pose>
    </include>

  </world>
</sdf>
