# Vision API Environment Variables Template
# Copy this to .env and add your actual keys: cp .env.example .env

# OpenAI API Key (for GPT-4o Vision)
export OPENAI_API_KEY="sk-..."

# Google Gemini API Key
export GEMINI_API_KEY="AI..."

# Hugging Face API Token
export HUGGINGFACE_API_TOKEN="hf_..."

# Generic key (defaults to OpenAI)
export VISION_API_KEY="${OPENAI_API_KEY}"
